{
  "private": false,
  "name": "dux-ui",
  "version": "1.3.3",
  "description": "Dux UI based on React",
  "main": "lib/index.js",
  "homepage": "https://dh1992.gitee.io/dux-ui-react",
  "keywords": [
    "npm",
    "package",
    "react",
    "dux-ui"
  ],
  "files": [
    "README.md",
    "index.d.ts",
    "dist/",
    "lib/"
  ],
  "author": "heng.du",
  "license": "MIT",
  "scripts": {
    "docs": "dumi dev",
    "docs:build": "dumi build",
    "docs:deploy": "gh-pages -d docs-dist",
    "build": "father-build",
    "build:webpack": "webpack",
    "build:babel": "babel src/ --extensions '.js,.jsx,.ts,.tsx' -d lib/ --ignore '**/.umi/*','**/__tests__/*' && node build-index.js",
    "build:dist": "NODE_ENV=production npm run build:webpack -- --config webpack.dist.config.js",
    "deploy": "npm run build:dist && npm run build:babel",
    "deploy:docs": "npm run docs:build && npm run docs:deploy",
    "prettier": "prettier --write \"**/*.{js,jsx,tsx,ts,less,md,json}\"",
    "test": "umi-test",
    "test:coverage": "umi-test --coverage",
    "commit": "cz",
    "prepublishOnly": "npm run build:dist",
    "release:patch": "standard-version --release-as patch",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major"
  },
  "module": "es/index.js",
  "typings": "es/index.d.ts",
  "gitHooks": {
    "pre-commit": "lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,less,md,json}": [
      "prettier --write"
    ],
    "*.ts?(x)": [
      "prettier --parser=typescript --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://gitee.com/dh1992/dux-ui-react.git"
  },
  "dependencies": {
    "@emotion/core": "^10.0.35",
    "@emotion/styled": "^10.0.27",
    "@z-r/calendar": "^0.2.2",
    "classnames": "^2.3.1",
    "color": "^4.2.1",
    "component-classes": "^1.2.6",
    "create-react-context": "^0.3.0",
    "emotion": "^10.0.27",
    "emotion-theming": "^10.0.27",
    "file-bytes-formatter": "^1.0.4",
    "lodash": "^4.17.21",
    "mini-store": "^3.0.6",
    "moment": "^2.29.3",
    "prop-types": "^15.8.1",
    "raf": "^3.4.1",
    "rc-dialog": "7.2.1",
    "rc-form": "^2.4.12",
    "rc-trigger": "^5.2.11",
    "react": "^16.12.0 || ^17.0.0",
    "react-lifecycles-compat": "^3.0.4",
    "react-transition-group": "^4.4.2"
  },
  "devDependencies": {
    "@babel/cli": "^7.11.6",
    "@babel/core": "^7.11.6",
    "@babel/plugin-proposal-class-properties": "^7.16.7",
    "@babel/plugin-proposal-decorators": "^7.17.8",
    "@babel/plugin-proposal-private-methods": "^7.16.11",
    "@babel/plugin-transform-runtime": "^7.17.0",
    "@babel/plugin-transform-typescript": "^7.16.8",
    "@babel/polyfill": "^7.4.4",
    "@babel/preset-env": "^7.3.1",
    "@babel/preset-react": "^7.0.0",
    "@babel/preset-typescript": "^7.16.7",
    "@emotion/babel-plugin": "^11.7.2",
    "@testing-library/jest-dom": "^5.15.1",
    "@testing-library/react": "^12.1.2",
    "@types/color": "^3.0.3",
    "@types/jest": "^27.0.3",
    "@types/lodash": "^4.14.179",
    "@types/raf": "^3.4.0",
    "@types/react-lifecycles-compat": "^3.0.1",
    "@umijs/fabric": "^2.8.1",
    "@umijs/test": "^3.0.5",
    "babel-loader": "^8.2.3",
    "babel-plugin-component": "^1.1.1",
    "babel-plugin-lodash": "^3.3.4",
    "babel-plugin-typescript-to-proptypes": "^2.0.0",
    "babel-plugin-webpack-alias": "^2.1.2",
    "commitizen": "^4.2.4",
    "copy-to-clipboard": "^3.3.1",
    "css-loader": "^6.7.1",
    "css-minimizer-webpack-plugin": "^3.4.1",
    "cz-conventional-changelog": "^3.3.0",
    "dumi": "^1.1.0",
    "father-build": "^1.17.2",
    "file-loader": "^6.2.0",
    "gh-pages": "^3.0.0",
    "jest-emotion": "^11.0.0",
    "lint-staged": "^10.0.7",
    "mini-css-extract-plugin": "^2.6.0",
    "prettier": "^2.2.1",
    "react-resizable": "^3.0.4",
    "standard-version": "^9.3.2",
    "style-loader": "^3.3.1",
    "terser-webpack-plugin": "^5.3.1",
    "typescript": "^4.3.2",
    "url-loader": "^4.1.1",
    "webpack": "^5.70.0",
    "webpack-bundle-analyzer": "^4.5.0",
    "webpack-cli": "^4.9.2",
    "yorkie": "^2.0.0"
  },
  "peerDependencies": {
    "react": "^16",
    "react-dom": "^16"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
